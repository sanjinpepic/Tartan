<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".TartanApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Health Connect shows why Tartan asks for access (Android 13 and older). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>

            <!-- Workout files from other apps: opened with Tartan, or shared to it (FIT, GPX, TCX). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/tcx+xml" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.garmin.tcx+xml" />
                <data android:mimeType="application/tcx+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="application/xml" />
            </intent-filter>
            <!-- Strava sign-in returns here (tartan://localhost/strava?code=…), from the Strava app or the browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tartan" android:host="localhost" />
                <!-- The name before Tartan: a sign-in started on an older build still lands. -->
                <data android:scheme="freesuunto" android:host="localhost" />
            </intent-filter>

        </activity>

        <!-- Health Connect shows why Tartan asks for access (Android 14 and newer). -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Today on the home screen (TodayWidget, fed by TartanWidgetPlugin). -->
        <receiver
            android:name=".TodayWidget"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <!-- Keeps Tartan running while the coach finishes an answer you left (Android 14+, a few minutes at most). -->
        <service
            android:name=".shell.CoachService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
        <!-- Pause and Resume from the run's Live Update (LiveUpdates.kt), lock screen included. -->
        <receiver
            android:name=".shell.RunActions"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tartan 2: the small clicks you feel on the native bar and screens (shell/Feel.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Live Updates (Android 16 and later): a run, a watch backup or the coach's answer as a chip
         in the status bar and on the lock screen (shell/LiveUpdates.kt). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The run's recording and the coach finishing an answer you left (CoachService) run as foreground services. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 17: the PC link on the home network (TartanLocalNetworkPlugin). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Scanning the PC's pairing QR code in the app (asked for only then). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Speaking a note instead of typing it (asked for only then; on-device recognition when the phone has it). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Bluetooth: talk to the watch. Scan results are never used for location. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <!-- Location: GPS for runs recorded on the phone (and Bluetooth scanning on Android 11 and
         older). The recording service's foreground and notification permissions come from the
         background-geolocation plugin's manifest. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Calendar: your plan's sessions as events in a calendar you pick (Settings → Training,
         off until you turn it on). Reminders' notification permission comes from the
         local-notifications plugin's manifest. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Health Connect (Settings → Sources, off until you connect it): workouts and the watch's
         heart rate, blood oxygen, resting heart rate, steps and active energy go in; other
         apps' workouts (so none is written twice), sleep and HRV are read. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE_ROUTE" />
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_PLANNED_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <!-- Other apps' workouts in full (Settings → Sources → Health Connect → Workouts from other
         apps): their heart rate, distance, speed and route, and the history before Tartan was
         connected (Health Connect otherwise gives 30 days). -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES" />
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" />
    <!-- The coach on Model Hub's models (TartanModelHubPlugin): a runtime permission Model Hub defines. -->
    <uses-permission android:name="dev.modelhub.permission.USE_MODELS" />
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <!-- Model Hub, which holds the on-phone models for every app, and its API. -->
        <package android:name="dev.modelhub" />
        <intent>
            <action android:name="dev.modelhub.action.BIND" />
        </intent>
        <!-- Android's speech recognizer, for notes spoken instead of typed. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Its voice-typing popup, the last resort when no recognizer listens in the background. -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
</manifest>
